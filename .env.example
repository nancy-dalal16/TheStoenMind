# Shopify Storefront API - copy to .env.local and fill in.
# Without these the shop runs in preview mode on the sample catalogue (src/lib/shop/sample.js)
# and the bag lives in the browser; checkout switches on once they are set.
#
# Token: Shopify admin → Sales channels → Headless (or Settings → Apps → Develop apps)
# → Storefront API access token. Scopes: unauthenticated_read_product_listings,
# unauthenticated_read_product_inventory, unauthenticated_write_checkouts,
# unauthenticated_read_checkouts.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# "public" (X-Shopify-Storefront-Access-Token) or "private" (Shopify-Storefront-Private-Token)
SHOPIFY_STOREFRONT_TOKEN_TYPE=public
SHOPIFY_API_VERSION=2026-10
